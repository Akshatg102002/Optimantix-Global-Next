# Resend API Key
RESEND_API_KEY=

# Firebase Configuration (Next.js client bundle - NEXT_PUBLIC_ prefix required
# for browser exposure; vite.config.ts also inlines these for the legacy Vite app)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCLxvTQ76Ak9RQ4eBGnlDiMk6lf1hlpNlY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=optx-b909c.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=optx-b909c
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=optx-b909c.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=768985312214
NEXT_PUBLIC_FIREBASE_APP_ID=1:768985312214:web:b04a1b1135acd6a63e1277

# Firebase Admin SDK (server-only, no NEXT_PUBLIC_ prefix — never sent to the
# browser). Used by lib/firebase-admin.ts to read Tier 1 SEO overrides and
# dynamic blog/case-study content directly in generateMetadata. Get these
# from a service account key in Firebase Console > Project Settings > Service
# Accounts. If unset, Tier 1 overrides are skipped and Tier 2/3 fallbacks apply.
FIREBASE_PROJECT_ID=optx-b909c
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Legacy Vite-only sitemap generation script still reads these
VITE_FIREBASE_API_KEY=AIzaSyCLxvTQ76Ak9RQ4eBGnlDiMk6lf1hlpNlY
VITE_FIREBASE_AUTH_DOMAIN=optx-b909c.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=optx-b909c
VITE_FIREBASE_STORAGE_BUCKET=optx-b909c.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=768985312214
VITE_FIREBASE_APP_ID=1:768985312214:web:b04a1b1135acd6a63e1277